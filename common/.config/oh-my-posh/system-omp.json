{
  "version": 4,
  "final_space": true,
  "palette": {
    "teal": "#00d2b4",
    "blue": "#3b82f6",
    "green": "#8ae234",
    "charcoal": "#2b2b2b",
    "gray": "#e5e7eb",
    "purple": "#8b5cf6",
    "coral": "#ea580c",
    "indigo": "#6366f1",
    "darkblue": "#1e3a8a",
    "darktext": "#111827",
    "whitetext": "#ffffff"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "template": "╭─"
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:darktext",
          "background": "p:teal",
          "template": " \uf17c WSL "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:whitetext",
          "background": "p:blue",
          "options": {
            "style": "full",
            "home_icon": "~"
          },
          "template": " \uf07c {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:darktext",
          "background": "p:green",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#eab308{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ef4444{{ end }}"
          ],
          "template": " \uf418 {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ else }} ={{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:whitetext",
          "background": "p:charcoal",
          "options": {
            "threshold": 0
          },
          "template": " ⏱ {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "shell",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:darktext",
          "background": "p:gray",
          "template": " \uf489 {{ .Name }} "
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:whitetext",
          "background": "p:purple",
          "options": {
            "precision": 2
          },
          "template": " 󰍛 {{ round .PhysicalPercentUsed .Precision }}% "
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:whitetext",
          "background": "p:indigo",
          "background_templates": [
            "{{ if or .Env.CLAUDE_CODE_ENTRYPOINT .Env.CLAUDE_PROJECT_ROOT .Env.CLAUDE_AGENT_ID .Env.CLAUDE_IS_ACTIVE }}p:coral{{ end }}",
            "{{ if or .Env.ANTIGRAVITY_TRAJECTORY_ID .Env.ANTIGRAVITY_AGENT .Env.ANTIGRAVITY_CONVERSATION_ID .Env.AGY_AGENT .Env.AGY }}p:indigo{{ end }}"
          ],
          "template": "{{ if or .Env.CLAUDE_CODE_ENTRYPOINT .Env.CLAUDE_PROJECT_ROOT .Env.CLAUDE_AGENT_ID .Env.CLAUDE_IS_ACTIVE }} 󰚩 Claude Code {{ else if or .Env.ANTIGRAVITY_TRAJECTORY_ID .Env.ANTIGRAVITY_AGENT .Env.ANTIGRAVITY_CONVERSATION_ID .Env.AGY_AGENT .Env.AGY }} ✦ agy {{ end }}"
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:whitetext",
          "background": "p:darkblue",
          "template": "  {{ .CurrentDate | date \"15:04\" }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "template": "╰─>> "
        }
      ]
    }
  ]
}
