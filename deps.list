# ==============================================================================
# deps.list: the single list of everything this repo depends on.
#
# Read by install.sh with plain bash (no jq), so keep to this format:
#   id | tier | check | brew | apt | fallback | required_by
#
#   id           Name. Optional platform suffix: @mac, @linux, @wsl, or @unix (linux+wsl).
#   tier         required | optional
#   check        cmd:a,b     any of these commands is on PATH
#                file:p1,p2  any of these paths exists (~ allowed)
#                py:module   python3 can import the module
#                pwbrowser:chromium  playwright's browser is downloaded (checked via the agent-skills venv)
#                font:a,b    any of these Nerd Fonts is installed in its Mono variant
#                            (Windows host fonts on WSL)
#   brew         brew:formula | cask:cask | -
#   apt          apt:package | -
#   fallback     Used when neither brew nor apt applies:
#                sh:<command> | nerdfont:<font name> | manual:<instructions> |
#                pip:<package> (into the agent-skills venv ~/.venvs/agent-skills, created if
#                missing and linked into python3 via a .pth file) |
#                pwinstall:chromium (playwright browser, needs the playwright row first) | -
#   required_by  Repo paths that need it. Keep this accurate (see AGENTS.md).
#
# Rows install in file order, so list a dependency before anything needing it.
# The | character separates fields, so sh: commands cannot use pipes.
# sh: commands download installers into a private mktemp -d dir, never a fixed /tmp name: a stale
# file owned by another user makes a fixed name unwritable and the installer silently never runs.
# ==============================================================================

# --- Bootstrap ----------------------------------------------------------------
git          | required | cmd:git        | brew:git   | apt:git   | -  | install.sh
stow         | required | cmd:stow       | brew:stow  | apt:stow  | -  | install.sh, common/.zsh/45-functions.zsh (restow)
curl         | required | cmd:curl       | brew:curl  | apt:curl  | -  | install.sh (sh: installers), common/.local/bin/chrome-debug
jq           | required | cmd:jq         | brew:jq    | apt:jq    | -  | common/.config/oh-my-posh/claude-statusline.sh, install.sh (settings wiring), common/.local/bin/chrome-debug (status tab list)

# --- Shell --------------------------------------------------------------------
zsh          | required | cmd:zsh        | brew:zsh   | apt:zsh   | -  | common/.zshrc, common/.zsh/
oh-my-posh   | required | cmd:oh-my-posh | brew:jandedobbeleer/oh-my-posh/oh-my-posh | - | sh:d=$(mktemp -d) && trap 'rm -rf "$d"' EXIT && curl -fsSL -o "$d/i.sh" https://ohmyposh.dev/install.sh && bash "$d/i.sh" -d ~/.local/bin | common/.zsh/50-prompt.zsh, common/.config/oh-my-posh/
# Either font works; terminals must use the Mono (NFM) variant, see README.
nerd-font    | required | font:CaskaydiaCove,GoogleSansCode | - | - | nerdfont:CascadiaCode | common/.config/oh-my-posh/*.json (glyphs)

fzf                     | optional | cmd:fzf          | brew:fzf     | apt:fzf      | - | common/.zsh/20-completion.zsh
zoxide                  | optional | cmd:zoxide       | brew:zoxide  | apt:zoxide   | - | common/.zsh/00-env.zsh
mise                    | optional | cmd:mise         | brew:mise    | -            | sh:d=$(mktemp -d) && trap 'rm -rf "$d"' EXIT && curl -fsSL -o "$d/i.sh" https://mise.run && sh "$d/i.sh" | common/.zsh/00-env.zsh (runtime manager: python, java, etc.)
zsh-autosuggestions     | optional | file:/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh,/opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh,/usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh | brew:zsh-autosuggestions | apt:zsh-autosuggestions | - | common/.zsh/30-plugins.zsh
zsh-syntax-highlighting | optional | file:/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh,/opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh,/usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh | brew:zsh-syntax-highlighting | apt:zsh-syntax-highlighting | - | common/.zsh/30-plugins.zsh
bat                     | optional | cmd:batcat,bat   | brew:bat     | apt:bat      | - | common/.zsh/40-aliases.zsh
fd                      | optional | cmd:fdfind,fd    | brew:fd      | apt:fd-find  | - | common/.zsh/40-aliases.zsh
xclip@unix              | optional | cmd:xclip        | -            | apt:xclip    | - | common/.zsh/os/wsl.zsh
chrome                  | optional | file:/Applications/Google Chrome.app,~/Applications/Google Chrome.app,/Applications/Chromium.app,/mnt/c/Program Files/Google/Chrome/Application/chrome.exe,/mnt/c/Program Files (x86)/Google/Chrome/Application/chrome.exe,/usr/bin/google-chrome,/usr/bin/google-chrome-stable,/usr/bin/chromium,/usr/bin/chromium-browser | cask:google-chrome | - | manual:Install Google Chrome from https://www.google.com/chrome/ | common/.local/bin/chrome-debug
rclone                  | optional | cmd:rclone       | brew:rclone  | -            | sh:d=$(mktemp -d) && trap 'rm -rf "$d"' EXIT && curl -fsSL -o "$d/i.sh" https://rclone.org/install.sh && sudo bash "$d/i.sh" | fabo repo scripts/ops-drive.sh (Google Drive sync of ~/fabo; outside this repo)

# --- Agents -------------------------------------------------------------------
claude       | optional | cmd:claude      | - | - | sh:d=$(mktemp -d) && trap 'rm -rf "$d"' EXIT && curl -fsSL -o "$d/i.sh" https://claude.ai/install.sh && bash "$d/i.sh" | common/.config/oh-my-posh/claude-omp.json, common/.config/oh-my-posh/claude-statusline.sh
antigravity  | optional | cmd:agy,antigravity | cask:antigravity-cli | - | manual:Install the Antigravity CLI from Google's Antigravity docs, then re-run install.sh | common/.config/oh-my-posh/agy-omp.json, common/.zsh/40-aliases.zsh (agy)
codex        | optional | cmd:codex      | - | - | sh:d=$(mktemp -d) && trap 'rm -rf "$d"' EXIT && curl -fsSL -o "$d/i.sh" https://chatgpt.com/codex/install.sh && CODEX_NON_INTERACTIVE=1 sh "$d/i.sh" | scripts/codex-config.sh, install.sh (Codex config, global instructions)

# --- Agent skills -------------------------------------------------------------
node         | optional | cmd:node        | brew:node   | apt:nodejs  | - | agent-skills/remind/scripts/remind.mjs, common/.local/bin/remind (Node 18+), kno-hub:bin/runbook and other kno-hub commands (Node 22+)
python3      | optional | cmd:python3     | brew:python | apt:python3 | - | kno-hub:kits/runbook/scripts/ (build_runbook.py; runbook.mjs tick rebuilds through it), fabo repo scripts/setup-python.sh (3.10+ for its .venv: pymupdf, matplotlib; outside this repo)
python3-venv@unix | optional | py:ensurepip | - | apt:python3-venv | - | install.sh (builds the agent-skills venv), fabo repo scripts/setup-python.sh (builds its .venv; outside this repo)
playwright   | optional | py:playwright | - | - | pip:playwright | kno-hub:kits/runbook/scripts/verify_runbook.py and build_runbook.py --pdf, agent-skills/visual/scripts/visual.py
chromium     | optional | pwbrowser:chromium | - | - | pwinstall:chromium | kno-hub:kits/runbook/scripts/verify_runbook.py and build_runbook.py --pdf, agent-skills/visual/scripts/visual.py (browser playwright drives)
pymupdf      | optional | py:pymupdf      | - | - | pip:pymupdf | agent-skills/visual/scripts/visual.py (PDF checks), kno-hub:kits/runbook/scripts/build_runbook.py --booklet
